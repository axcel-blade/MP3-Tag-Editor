# Optional — MusicBrainz, iTunes, and Deezer work without keys

# Musixmatch — lyrics + metadata (https://developer.musixmatch.com/)
MUSIXMATCH_API_KEY=

# Last.fm — get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Discogs — personal access token from https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Spotify — optional; requires Premium on developer account
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MusicBrainz User-Agent (required by their API policy)
MUSICBRAINZ_USER_AGENT=MP3TagEditor/1.1.0 (your-email@example.com)
