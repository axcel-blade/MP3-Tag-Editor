{
  "appId": "com.axcelblade.mp3tageditor",
  "productName": "MP3 Tag Editor",
  "copyright": "Copyright © 2026 Axcel Blade",
  "directories": {
    "output": "release",
    "buildResources": "build-resources"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "asar": true,
  "publish": {
    "provider": "github",
    "owner": "axcel-blade",
    "repo": "mp3-tag-editor",
    "releaseType": "release"
  },
  "win": {
    "target": ["nsis"],
    "artifactName": "MP3-Tag-Editor-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.music",
    "artifactName": "MP3-Tag-Editor-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Audio",
    "artifactName": "MP3-Tag-Editor-${version}.${ext}",
    "maintainer": "Axcel Blade <56168280+axcel-blade@users.noreply.github.com>",
    "syncDesktopName": true
  }
}
